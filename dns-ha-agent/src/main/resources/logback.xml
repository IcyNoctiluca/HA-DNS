<?xml version="1.0" encoding="UTF-8"?>
<!--
  JSON to stdout, per AGENTS.md invariant #9 ("Logs are JSON to stdout").
  UTC timestamps per AGENTS.md "Operational conventions". No file appenders
  — the container's stdout is captured by Docker's json-file log driver
  (see BLUEPRINT.md §11 docker-compose snippet).
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timeZone>UTC</timeZone>
            <fieldNames>
                <timestamp>ts</timestamp>
                <message>msg</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <level>level</level>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
