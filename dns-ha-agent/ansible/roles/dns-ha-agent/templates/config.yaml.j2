version: 1

node:
  name: {{ dns_ha_agent_node_name }}
  region: {{ dns_ha_agent_node_region }}
  vip: {{ dns_ha_agent_vip }}

probe:
  target: {{ dns_ha_agent_vip | regex_replace('/.*$', '') }}
  resolve_names:
{% for name in dns_ha_agent_resolve_names | default(['cloudflare.com', 'example.com']) %}
    - {{ name }}
{% endfor %}
  resolve_type: A
  block_name: {{ dns_ha_agent_filter_sentinel }}
  block_expectation:
    mode: must_not_return_real_ip
    allowed_rcodes:
      - NXDOMAIN
      - REFUSED
      - NOERROR
    allowed_ips:
      - "0.0.0.0"
  interval: 2s
  query_timeout: 2s
  fail_threshold: 2
  success_threshold: 3

peers:
{% for peer in dns_ha_agent_peers %}
  - name: {{ peer.name }}
    health_url: http://{{ peer.tailscale_ip }}:{{ dns_ha_agent_http_port }}/health
{% endfor %}

split_brain:
  enabled: {{ (dns_ha_agent_peers | length) >= 2 }}
  peer_poll_interval: 15s
  peer_poll_timeout: 5s
  peer_unreachable_threshold: 60s
  min_peer_reports_to_self_withdraw: 2

tailscale:
  mode: cli
  cli_path: /usr/bin/tailscale
  # Explicit --socket flag for the CLI (fixed 2026-07-22). The container's
  # TS_SOCKET env var (docker-compose.yml.j2) does NOT configure the
  # `tailscale` CLI client itself — only `tailscaled`/containerboot read it
  # (tailscale/tailscale upstream issue #14406, still open). This field is
  # what actually lets dns_ha_agent_tailscale_socket be a real per-node
  # override; see CliTailscaleClient/TailscaleConfig javadoc.
  socket_path: {{ dns_ha_agent_tailscale_socket }}
  managed_routes:
    - {{ dns_ha_agent_vip }}
  preserved_routes: {{ dns_ha_agent_preserved_routes | default([]) | to_json }}
  command_timeout: 10s

http:
  # Bind to the node's Tailscale IP (NOT 0.0.0.0) — with network_mode: host,
  # binding to wildcard exposes /health and /metrics on the LAN NIC too.
  bind_address: {{ ansible_tailscale0.ipv4.address }}
  port: {{ dns_ha_agent_http_port }}

logging:
  format: JSON
  level: INFO

metrics:
  enabled: true  # see BLUEPRINT.md §5 -- HealthServer now honors this (fixed 2026-07-23)
  path: /metrics  # MUST stay "/metrics" -- ConfigLoader.validate() rejects any other value
