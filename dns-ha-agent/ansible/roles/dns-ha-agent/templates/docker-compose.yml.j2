services:
  dns-ha-agent:
    # IMMUTABLE DIGEST PIN — never use :latest in production deploys.
    # Digest is rendered into this file by the ansible role from
    # dns_ha_agent_image_digest, which is bumped on each intentional deploy.
    # Rollback = change the digest var back to a known-good value, redeploy.
    image: {{ dns_ha_agent_image_repo }}@{{ dns_ha_agent_image_digest }}
    container_name: dns-ha-agent
    restart: unless-stopped
    network_mode: host
    environment:
      # Documentation-only (fixed 2026-07-22 — this was previously believed,
      # incorrectly, to configure the CLI's socket lookup): TS_SOCKET is read
      # by `tailscaled`/the official image's `containerboot` entrypoint, NOT
      # by the `tailscale` CLI client (tailscale/tailscale upstream issue
      # #14406, "FR: Make TS_SOCKET work with the `tailscale` CLI", still open
      # as of this writing). This container runs neither — it bind-mounts the
      # HOST's already-running tailscaled.sock and subprocesses the CLI
      # against it — so this env var has no functional effect here either
      # way. Left set purely so `docker inspect`/`docker compose config`
      # shows the intended socket path at a glance. The line that actually
      # makes a non-default socket path work is `tailscale.socket_path` in
      # config.yaml.j2, rendered from this same variable and passed to the
      # CLI as `--socket=...` by CliTailscaleClient.
      TS_SOCKET: {{ dns_ha_agent_tailscale_socket }}
    volumes:
      - {{ dns_ha_agent_config_dir }}/config.yaml:/etc/dns-ha-agent/config.yaml:ro
      - {{ dns_ha_agent_state_dir }}:/var/lib/dns-ha-agent
      # REQUIRED: the in-container tailscale CLI talks to the host's tailscaled
      # via its LocalAPI Unix socket. `network_mode: host` does NOT expose the
      # host filesystem socket — without this explicit mount, every
      # `tailscale set --advertise-routes=...` invocation will fail and the
      # agent will not be able to perform its core function. The TS_SOCKET env
      # var above points the CLI at this exact path.
      - {{ dns_ha_agent_tailscale_socket }}:{{ dns_ha_agent_tailscale_socket }}
    deploy:
      resources:
        limits:
          memory: {{ dns_ha_agent_memory_limit }}
          cpus: '{{ dns_ha_agent_cpu_limit }}'
    # HEALTHCHECK lives here (not in the Dockerfile) because the agent binds
    # to the node's Tailscale IP and that IP isn't known at image-build time.
    # Diagnostic only — does NOT trigger restart; see WatchdogThread
    # (../../BLUEPRINT.md §4, AGENTS.md invariant on internal liveness).
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://{{ ansible_tailscale0.ipv4.address }}:{{ dns_ha_agent_http_port }}/health"]
      interval: 10s
      timeout: 3s
      start_period: 20s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: "{{ dns_ha_agent_log_max_size }}"
        max-file: "{{ dns_ha_agent_log_max_file }}"
